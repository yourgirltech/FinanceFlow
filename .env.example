# Copy this file to .env (or .env.local) and fill in your own Supabase project values.
# Find these under Project Settings > API in your Supabase dashboard.
# The anon key is safe to expose in frontend code — it's designed to be public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
