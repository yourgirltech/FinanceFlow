VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret for the AI Assistant feature (netlify/functions/spending-insights.mjs).
# Deliberately NOT prefixed with VITE_ — Vite only exposes VITE_-prefixed vars to
# client code, so this stays out of the browser bundle. Set it as a real Netlify
# environment variable for the deployed site; locally, `netlify dev` reads it from
# this .env file when running the function.
ANTHROPIC_API_KEY=your-anthropic-api-key
